# Copiez ce fichier en .env.local et remplissez vos valeurs

# Clé API Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email de réception des demandes de devis et contact
CONTACT_EMAIL=votre@email.com

# Email expéditeur vérifié sur Resend (doit correspondre à votre domaine)
FROM_EMAIL=contact@perfect-amenagement.fr
